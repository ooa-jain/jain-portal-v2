# Copy to .env and fill in. The names match the old Flask app's .env, so that file can be reused.

# Required
MONGO_URI=
SECRET_KEY=            # at least 16 characters; signs the session cookie

# Optional
DB_NAME=semreadiness
ADMIN_EMAILS=          # comma-separated emails that are always admins
ALLOWED_EMAIL_DOMAIN=jainuniversity.ac.in
BASE_URL=              # e.g. https://jain-sarathi.juooa.cloud (used in emailed links)
UPLOAD_DIR=uploads     # point at the old app's static/uploads to keep old file links working

CRON_SECRET=           # long random string; enables scheduled deadline reminders (see README)

# Email (optional; when unset, emails are skipped and HODs copy the link instead)
EMAIL_USER=
EMAIL_PASS=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
